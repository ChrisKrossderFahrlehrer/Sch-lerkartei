// ╔══════════════════════════════════════════════════════════════════╗
// ║   ADK – DIGITALE KARTEI · Firestore-Sicherheitsregeln              ║
// ║   © 2026 ChrisKross der Fahrlehrer (Chriskoo)                      ║
// ║   fahrschülerkartei.de · Kontakt: chriskoo@mail.de                 ║
// ║                                                                    ║
// ║   ─────────────── ALLE RECHTE VORBEHALTEN ───────────────         ║
// ║                                                                    ║
// ║   Diese Sicherheitsregeln und der gesamte zugehörige Quellcode     ║
// ║   sind urheberrechtlich geschützt (§ 69a ff. UrhG). Das Urheber-   ║
// ║   recht liegt ausschließlich beim Entwickler.                      ║
// ║                                                                    ║
// ║   Das Kopieren, Nachbauen, Verbreiten oder Wiederverwenden –       ║
// ║   auch in Teilen – ist streng verboten und wird zivil- und         ║
// ║   strafrechtlich verfolgt (§ 106 UrhG: Freiheitsstrafe bis zu      ║
// ║   3 Jahren oder Geldstrafe; §§ 97 ff. UrhG: Schadensersatz).       ║
// ╚══════════════════════════════════════════════════════════════════╝

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════
    // HILFSFUNKTIONEN
    // ══════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'chriskoo@mail.de' ||
        (userDocExists() && userData().rolle == 'superadmin') ||
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
      );
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userFsId() {
      return userDocExists() ? userData().fahrschuleId : request.auth.uid;
    }

    function isFsAdmin() {
      return isAuth() && userDocExists() && userData().rolle == 'fs_admin';
    }

    // Helper: Dokument gehört zum User (neue oder alte Struktur)
    function docBelongsToUser(resData) {
      return resData.fahrschuleId == userFsId() ||
             resData.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // SUPERADMINS
    // ══════════════════════════════════════════════════════
    match /superadmins/{uid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULEN
    // ══════════════════════════════════════════════════════
    match /fahrschulen/{fsId} {
      allow read: if isSuperAdmin() ||
                     isAuth();  // Auth. Nutzer dürfen lesen (für Fahrschul-Code-Suche bei Registrierung)

      allow create: if isAuth() &&
                       (request.resource.data.adminUid == request.auth.uid ||
                        fsId == request.auth.uid);

      // UPDATE: Ein FS-Admin darf seine eigene Fahrschule bearbeiten, ABER
      // 'kalenderAktiv' (bezahltes Extra) darf nur der SuperAdmin setzen.
      allow update: if isSuperAdmin() ||
                       (isFsAdmin() && userFsId() == fsId &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false));

      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERS (Fahrlehrer, Admins, SuperAdmin)
    // ══════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if isAuth() && (
                    request.auth.uid == uid ||
                    isSuperAdmin() ||
                    isFsAdmin()
                  );

      // CREATE: Beim Anlegen des EIGENEN Kontos dürfen sicherheitsrelevante
      // Felder NICHT frei gewählt werden. rolle muss 'fahrlehrer' oder
      // 'fahrschul-admin' sein (NIE superadmin/fs_admin), status muss
      // 'ausstehend' sein, und kalenderAktiv darf nicht aktiv sein.
      // Nur der SuperAdmin darf beliebige Werte setzen.
      allow create: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        request.auth.uid == uid &&
                        request.resource.data.rolle in ['fahrlehrer', 'fahrschul-admin'] &&
                        request.resource.data.get('status', 'ausstehend') == 'ausstehend' &&
                        request.resource.data.get('kalenderAktiv', false) == false
                      )
                    );

      // UPDATE: Ein Nutzer darf sein eigenes Doc bearbeiten, aber die
      // sicherheitsrelevanten Felder rolle, status und kalenderAktiv müssen
      // dabei UNVERÄNDERT bleiben. Nur SuperAdmin (bzw. FsAdmin für status)
      // darf diese ändern. Das verhindert Selbst-Hochstufung, Umgehung der
      // Zahlungssperre und kostenlose Kalender-Freischaltung.
      allow update: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        (request.auth.uid == uid || isFsAdmin()) &&
                        request.resource.data.rolle == resource.data.rolle &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false) &&
                        (
                          // status darf nur ein FsAdmin ändern, nicht man selbst
                          isFsAdmin() ||
                          request.resource.data.get('status', '')
                            == resource.data.get('status', '')
                        )
                      )
                    );

      allow delete: if isSuperAdmin() || isFsAdmin();
    }

    // ══════════════════════════════════════════════════════
    // SCHÜLER
    // ══════════════════════════════════════════════════════
    match /students/{studentId} {
      // SuperAdmin darf lesen (nötig zum Auffinden beim Voll-Löschen)
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && (
                       docBelongsToUser(resource.data) ||
                       request.resource.data.uid == request.auth.uid
                     );
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PROTOKOLL
    // ══════════════════════════════════════════════════════
    match /protokoll/{eintragId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM FIELDS
    // ══════════════════════════════════════════════════════
    match /customFields/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM THEMEN
    // ══════════════════════════════════════════════════════
    match /customThemen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM GRUPPEN (eigene Überschriften im Eigene-Tab)
    // ══════════════════════════════════════════════════════
    match /customGruppen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PASSWORT-RESET ANFRAGEN
    // create OHNE Auth (User ist ausgesperrt!) — streng validiert
    // ══════════════════════════════════════════════════════
    match /passwordResets/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['username','kontakt','status','createdAt']) &&
                       request.resource.data.username is string &&
                       request.resource.data.username.size() >= 3 &&
                       request.resource.data.username.size() <= 50 &&
                       request.resource.data.kontakt is string &&
                       request.resource.data.kontakt.size() >= 5 &&
                       request.resource.data.kontakt.size() <= 100 &&
                       request.resource.data.status == 'offen';
      allow read, update, delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // ACCESS CODES (für Schüler-Zugangscodes)
    // ══════════════════════════════════════════════════════
    match /accessCodes/{docId} {
      // DATENSCHUTZ-FIX: Firestore unterscheidet 'get' (ein einzelnes Dokument)
      // und 'list' (Abfrage über die Collection). Das Schüler-Portal liest pro
      // Code nur EIN Dokument (Code = Dokument-ID) – das erlauben wir. Das
      // massenhafte Auslesen der GANZEN Collection (list) ist für nicht-
      // eingeloggte Nutzer VERBOTEN. So kann kein Angreifer alle Schülerdaten
      // auf einmal abgreifen (DSGVO Art. 32). Eingeloggte Fahrlehrer dürfen
      // listen (brauchen sie zum Verwalten/Verlängern der Codes).
      allow get:  if true;
      allow list: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
      // Schüler-Portal: ohne Login NUR messages + plannedLessons + lernziele updaten.
      allow update: if isAuth() ||
                       request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['messages', 'plannedLessons', 'lernziele']);
    }

    // ══════════════════════════════════════════════════════
    // CHAT
    // ══════════════════════════════════════════════════════
    match /chat/{msgId} {
      allow read:   if isAuth() &&
                       resource.data.fahrschuleId == userFsId();
      allow create: if isAuth() &&
                       request.resource.data.senderUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuth() &&
                       resource.data.senderUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // PLATFORM (Impressum, Einstellungen)
    // ══════════════════════════════════════════════════════
    match /platform/{docId} {
      // Impressum/Broadcast werden gezielt per get() geladen (das Impressum
      // MUSS öffentlich sein – rechtliche Pflicht). list() ist gesperrt.
      allow get:   if true;
      allow list:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERNAMES (Benutzername → E-Mail Zuordnung für Login)
    // Öffentlich lesbar, damit Login per Benutzername funktioniert.
    // Enthält KEINE sensiblen Daten (nur username, email, uid).
    // ══════════════════════════════════════════════════════
    match /usernames/{uname} {
      // get() für den Login-Lookup (Benutzername ist Doc-ID) ist erlaubt.
      // list() ist gesperrt → niemand kann alle Benutzernamen+uids abgreifen
      // (Schutz vor Enumeration / DSGVO).
      allow get:    if true;
      allow list:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULKALENDER (separates App, gemeinsames Projekt)
    // Eigene Collections, eigenes Rollensystem (role/approved/schoolId).
    // kalenderUsers ist getrennt von ADKs users, damit keine Kollision.
    // ══════════════════════════════════════════════════════
    function kalAuth() { return request.auth != null; }
    function kalIsSuperAdmin() {
      return kalAuth() && request.auth.token.email == 'chriskoo@mail.de';
    }
    // Existiert mein Kalender-Profil? (Schutz vor get() auf nicht-existentes Doc)
    function kalUserExists() {
      return kalAuth() && exists(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid));
    }
    // Meine eigene Schul-ID (aus meinem kalenderUsers-Profil)
    function kalMySchool() {
      return get(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid)).data.schoolId;
    }
    // Gehört ein Dokument mit dieser schoolId zu MEINER Schule? (oder bin ich SuperAdmin)
    function kalOwnsSchool(sid) {
      return kalIsSuperAdmin() || (kalUserExists() && kalMySchool() == sid);
    }
    // Gehört ein Lehrer (per UID) zu meiner Schule? (für Collections ohne schoolId, z.B. blocked)
    function kalLehrerInMySchool(luid) {
      return kalIsSuperAdmin() ||
             (luid == request.auth.uid) ||
             (kalUserExists() &&
              exists(/databases/$(database)/documents/kalenderUsers/$(luid)) &&
              get(/databases/$(database)/documents/kalenderUsers/$(luid)).data.schoolId == kalMySchool());
    }

    // Die ADK-fahrschuleId des Nutzers (autoritativ, da users.rolle jetzt
    // geschützt ist). Wird genutzt, um die Kalender-schoolId fest an die
    // echte Identität zu binden – so kann niemand eine fremde schoolId wählen.
    function kalAdkFahrschuleId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fahrschuleId
        : null;
    }

    // Kalender-Nutzerprofile: eigenes Doc immer; fremde nur in eigener Schule.
    // WICHTIG: Beim Anlegen/Ändern des eigenen Profils muss die schoolId mit
    // der ADK-fahrschuleId übereinstimmen (oder SuperAdmin) – verhindert, dass
    // sich jemand einer fremden Fahrschule zuordnet (Cross-Tenant-Schutz).
    match /kalenderUsers/{uid} {
      allow read:   if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid) ||
                       (kalUserExists() && resource.data.schoolId == kalMySchool());
      allow create: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid &&
                        request.resource.data.schoolId == kalAdkFahrschuleId());
      allow update: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid &&
                        request.resource.data.schoolId == kalAdkFahrschuleId());
      allow delete: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid);
    }

    // Fahrschulen im Kalender: nur die eigene
    match /schools/{schoolId} {
      allow read:   if kalIsSuperAdmin() ||
                       (kalUserExists() && kalMySchool() == schoolId);
      allow create: if kalAuth() && request.resource.data.adminUid == request.auth.uid;
      allow update: if kalIsSuperAdmin() ||
                       (kalUserExists() && kalMySchool() == schoolId);
      allow delete: if kalIsSuperAdmin();
    }

    // ── Daten-Collections mit schoolId: streng pro Fahrschule getrennt ──
    // read/update/delete prüfen die schoolId des BESTEHENDEN Dokuments,
    // create prüft die schoolId des NEUEN Dokuments. So kann niemand Daten
    // einer fremden Fahrschule lesen, ändern oder unterschieben.
    match /schueler/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /slots/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /autos/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /globalBlocked/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /urlaub/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /notizen/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /warteliste/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /pruefungen/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    // blocked hat kein schoolId, nur lehrerUid → über den Lehrer absichern
    match /blocked/{docId} {
      allow read, update, delete: if kalLehrerInMySchool(resource.data.lehrerUid);
      allow create:               if kalLehrerInMySchool(request.resource.data.lehrerUid);
    }
    // mailQueue: enthält E-Mail-Inhalte (personenbezogen). Jeder eingeloggte
    // Nutzer darf eine Mail EINREIHEN (create), aber nur SuperAdmin/System
    // darf den Inhalt LESEN. Kein Lesen durch normale Nutzer.
    match /mailQueue/{docId} {
      allow create: if kalAuth();
      allow read:   if kalIsSuperAdmin();
      allow update, delete: if kalIsSuperAdmin();
    }
    // App-Einstellungen: lesen alle Eingeloggten, schreiben nur SuperAdmin
    match /settings/{docId} {
      allow read:  if kalAuth();
      allow write: if kalIsSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // ALLES ANDERE: VERBOTEN
    // ══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
