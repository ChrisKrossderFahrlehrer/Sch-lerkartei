// ╔══════════════════════════════════════════════════════════════════╗
// ║   ADK – DIGITALE KARTEI · Firestore-Sicherheitsregeln              ║
// ║   © 2026 ChrisKross der Fahrlehrer (Chriskoo)                      ║
// ║   fahrsync.de · Kontakt: kontakt@fahrsync.de                 ║
// ║                                                                    ║
// ║   ─────────────── ALLE RECHTE VORBEHALTEN ───────────────         ║
// ║                                                                    ║
// ║   Diese Sicherheitsregeln und der gesamte zugehörige Quellcode     ║
// ║   sind urheberrechtlich geschützt (§ 69a ff. UrhG). Das Urheber-   ║
// ║   recht liegt ausschließlich beim Entwickler.                      ║
// ║                                                                    ║
// ║   Das Kopieren, Nachbauen, Verbreiten oder Wiederverwenden –       ║
// ║   auch in Teilen – ist streng verboten und wird zivil- und         ║
// ║   strafrechtlich verfolgt (§ 106 UrhG: Freiheitsstrafe bis zu      ║
// ║   3 Jahren oder Geldstrafe; §§ 97 ff. UrhG: Schadensersatz).       ║
// ╚══════════════════════════════════════════════════════════════════╝

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════
    // HILFSFUNKTIONEN
    // ══════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'chriskoo@mail.de' ||
        (userDocExists() && userData().rolle == 'superadmin') ||
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
      );
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userFsId() {
      return userDocExists() ? userData().fahrschuleId : request.auth.uid;
    }
    // SICHERHEITS-AUDIT: unterscheidet ein ECHTES Fahrlehrer/Fahrschul-Konto
    // von einer anonymen Schüler-Session. Wo Regeln bisher nur "isAuth()"
    // prüften, konnte eine anonyme Session dieselben Rechte erhalten wie ein
    // echter Account (z.B. sich selbst als Fahrlehrer eintragen, fremde
    // Fahrschul-Chats beschreiben). Schließt das für alle Schreibzugriffe.
    function isRealAccount() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isFsAdmin() {
      // FIX: Rolle wird ueberall als 'fahrschul-admin' gespeichert, nicht 'fs_admin'.
      // Ohne diesen Fix war isFsAdmin() IMMER false (Tippfehler-Bug).
      // SICHERHEITS-AUDIT (im Emulator nachgewiesen): Die Rolle allein
      // genuegte. Die Rolle waehlt man aber bei der Registrierung SELBST -
      // auch beim Beitritt zu einer fremden Schule. Wer den Fahrschul-Code
      // kannte, trat als 'fahrschul-admin' bei, blieb zwar 'ausstehend',
      // durfte aber schon die Profile der Schule lesen und ein zweites,
      // ebenfalls wartendes Konto selbst freischalten - damit Vollzugriff auf
      // die fremde Kartei, ganz ohne Freigabe durch einen Menschen.
      // Inhaber ist nur, wessen Fahrschule die EIGENE ist. Genau so legen
      // index.html und adk-platform.html Fahrschulen an (Fahrschul-ID = UID
      // des Inhabers); kein Programmteil kennt einen anderen Fall.
      return isAuth() && userDocExists() && userData().rolle == 'fahrschul-admin'
             && userData().get('fahrschuleId', request.auth.uid) == request.auth.uid;
    }

    // SICHERHEITS-AUDIT (Cross-Tenant-Kette): Ist das Konto fuer die Fahrschule
    // freigegeben? Der Freigabe-Status wurde bisher NUR im Bildschirm geprueft,
    // nie in den Regeln. Wer sich mit einem Fahrschul-Code eintrug, konnte die
    // gesamte Kartei der Schule lesen, BEVOR ihn jemand freigeschaltet hatte -
    // und durfte sich beim Anlegen sogar selbst 'aktiv' setzen.
    // Altkonten ohne das Feld gelten weiter als freigegeben, damit niemand
    // ausgesperrt wird.
    function istFreigegeben() {
      return userDocExists() &&
             userData().get('status', 'aktiv') != 'ausstehend' &&
             userData().get('status', 'aktiv') != 'gesperrt';
    }

    // Helper: Dokument gehört zum User (neue oder alte Struktur)
    // Die Freigabe wird NUR verlangt, wenn man Daten einer FREMDEN Fahrschule
    // sieht (userFsId() != eigene uid) - genau der Weg, ueber den ein
    // erratener Fahrschul-Code sonst sofort die ganze Kartei oeffnen wuerde.
    // Wer seine eigene Schule ist (Inhaber, Einzel-Fahrlehrer) oder auf
    // eigene Datensaetze (uid) zugreift, ist davon nicht betroffen - so wird
    // kein bestehendes Konto ausgesperrt.
    // SICHERHEITS-AUDIT (Befund F3, im Emulator nachgewiesen): Der zweite
    // Zweig stand vorher allein als "resData.uid == request.auth.uid" da und
    // galt damit unbefristet. Nach uebernehmeSchuelerInFahrschule zeigt
    // fahrschuleId auf die Schule, uid aber weiterhin auf den alten Lehrer -
    // verliess dieser die Schule, konnte er ihre Schueler weiterhin lesen,
    // aendern und LOESCHEN. Jetzt gilt der uid-Zweig nur noch, solange der
    // Datensatz auch wirklich zu ihm gehoert: entweder ihm selbst
    // (fahrschuleId == eigene uid, der eigenstaendige Fahrlehrer) oder seiner
    // AKTUELLEN Fahrschule. Beides deckt die Faelle ab, wegen derer der Zweig
    // ueberhaupt existiert - eigene Schueler bleiben sichtbar, auch solche,
    // die noch nicht in die Schule uebernommen wurden.
    function eigenerDatensatz(resData) {
      return resData.uid == request.auth.uid && (
               resData.get('fahrschuleId', request.auth.uid) == request.auth.uid ||
               resData.get('fahrschuleId', request.auth.uid) == userFsId()
             );
    }

    function docBelongsToUser(resData) {
      return (resData.fahrschuleId == userFsId() &&
              (userFsId() == request.auth.uid || istFreigegeben())) ||
             eigenerDatensatz(resData);
    }

    // SICHERHEITS-AUDIT: Cross-Tenant-Schutz fuer Schueler/Protokoll/Custom-*.
    // Vorher pruefte create/update nur 'uid', NIE 'fahrschuleId' - jeder echte
    // Fahrlehrer-Account konnte Dokumente mit einer FREMDEN fahrschuleId
    // anlegen oder eine bestehende fahrschuleId auf eine fremde Schule
    // umbiegen und so fremde Kartei-Daten sichtbar/beeinflussbar machen.
    // Nur relevant, wenn die Collection ueberhaupt eine fahrschuleId nutzt
    // (customFields speichert z.B. nur 'uid') - deshalb .get() mit Default.
    // Zusatz: In eine FREMDE Schule (fahrschuleId != eigene uid) darf nur
    // schreiben, wer dort freigegeben ist - dieselbe Bedingung wie beim Lesen
    // (docBelongsToUser). Sonst konnte ein wartendes oder gesperrtes Mitglied
    // der Schule weiterhin Datensaetze unterschieben.
    function fahrschuleIdOkBeiCreate(data) {
      return data.get('fahrschuleId', userFsId()) == userFsId() &&
             (data.get('fahrschuleId', request.auth.uid) == request.auth.uid ||
              istFreigegeben());
    }

    // Mitglied einer Schule im Sinne von "darf ihre gemeinsamen Daten sehen":
    // die eigene Schule immer, eine fremde nur mit Freigabe. Gleiche Logik
    // wie docBelongsToUser, fuer Sammlungen ohne uid-Feld (Team-Chat).
    function schulMitglied(fsId) {
      return fsId == userFsId() &&
             (fsId == request.auth.uid || istFreigegeben());
    }
    // 'uid' bleibt bewusst aenderbar (Schueler an Kollegen derselben Schule
    // uebergeben, siehe index.html transferStudent) - nur 'fahrschuleId'
    // darf sich nach dem Anlegen nicht mehr aendern.
    function fahrschuleIdUnveraendert(before, after) {
      return after.get('fahrschuleId', before.get('fahrschuleId', null))
          == before.get('fahrschuleId', null);
    }

    // SICHERHEITS-AUDIT: Abo-Felder duerfen NIE direkt vom Client geschrieben
    // werden - nur serverseitig durch die Cloud Functions (Admin SDK, umgeht
    // diese Regeln ohnehin) nach echter, geprüfter Zahlung. Vorher liess sich
    // z.B. per Browser-Konsole updateDoc(users/eigeneUid,{abo:'unbegrenzt'})
    // aufrufen und sich damit ein kostenloses Premium-Abo selbst freischalten.
    function aboFelderUnveraendert(before, after) {
      return after.get('abo', null)                == before.get('abo', null)
          && after.get('aboStatus', null)            == before.get('aboStatus', null)
          && after.get('aboPlaner', null)             == before.get('aboPlaner', null)
          && after.get('aboMaxLehrer', null)           == before.get('aboMaxLehrer', null)
          && after.get('aboSubscriptionId', null)      == before.get('aboSubscriptionId', null)
          && after.get('aboPlanId', null)               == before.get('aboPlanId', null)
          && after.get('aboAktiviertAm', null)         == before.get('aboAktiviertAm', null)
          && after.get('aboSetByAdmin', null)          == before.get('aboSetByAdmin', null)
          && after.get('aboLetzteZahlungAm', null)     == before.get('aboLetzteZahlungAm', null)
          && after.get('aboZahlungsart', null)         == before.get('aboZahlungsart', null)
          // Kuendigungs-Vormerkung (functions/abo.js): Wer sie selbst
          // loeschen koennte, behielte den bezahlten Tarif nach der
          // Kuendigung fuer immer.
          && after.get('aboGekuendigtAm', null)        == before.get('aboGekuendigtAm', null)
          && after.get('aboEndetAm', null)             == before.get('aboEndetAm', null)
          && after.get('aboGekuendigteSubscriptionId', null) == before.get('aboGekuendigteSubscriptionId', null)
          && after.get('aboKuendigungQuelle', null)    == before.get('aboKuendigungQuelle', null)
          && after.get('aboBeendetAm', null)           == before.get('aboBeendetAm', null)
          && after.get('aboVorherigeSubscriptionId', null) == before.get('aboVorherigeSubscriptionId', null);
    }
    // FIX: Diese Regel hat 'abo' pauschal mitverboten - und damit zwei
    // Registrierungswege komplett blockiert, die beim Anlegen ganz harmlos
    // 'abo: free' mitschreiben:
    //   1. Die Fahrschul-Registrierung (schreibt fahrschulen/{uid} mit
    //      abo:'free') - eine Fahrschule konnte sich gar nicht mehr anmelden.
    //   2. Das Anlegen eines Fahrlehrers durch den SuperAdmin - dort wird das
    //      users-Dokument geschrieben, WAEHREND der neue Nutzer angemeldet
    //      ist, die SuperAdmin-Ausnahme greift also nicht.
    // Der Schutzzweck bleibt vollstaendig erhalten: Kein bezahlter Tarif und
    // kein einziges weiteres Abo-Feld darf beim Anlegen gesetzt werden. Nur
    // der Wert 'free' ist erlaubt, und der verleiht nichts - er ist genau
    // das, was ein frisches Konto ohnehin hat.
    function keineAboFelderBeiCreate(data) {
      return !data.keys().hasAny([
        'aboStatus','aboPlaner','aboMaxLehrer','aboSubscriptionId',
        'aboPlanId','aboAktiviertAm','aboSetByAdmin','aboLetzteZahlungAm','aboZahlungsart',
        'aboGekuendigtAm','aboEndetAm','aboGekuendigteSubscriptionId','aboKuendigungQuelle',
        'aboBeendetAm','aboVorherigeSubscriptionId'
      ]) && data.get('abo', 'free') == 'free';
    }

    // Die Loeschvormerkung (DSGVO-Frist) darf ausschliesslich serverseitig
    // gesetzt und wieder entfernt werden - ueber die Cloud Functions
    // kontoLoeschungBeantragen / kontoLoeschungWiderrufen. Koennte ein Client
    // sie selbst schreiben, liesse sich die Loeschung eines fremden Kontos
    // ausloesen oder die eigene, bereits beantragte Loeschung still
    // aushebeln, ohne dass es je protokolliert wird.
    function loeschmarkerUnveraendert(before, after) {
      return after.get('geloeschtAm', null) == before.get('geloeschtAm', null)
          && after.get('loeschungAm', null) == before.get('loeschungAm', null);
    }

    // Helper: Stimmt der beim Beitritt mitgesendete Code mit dem Code der
    // Ziel-Fahrschule überein? Verhindert, dass jemand seine fahrschuleId
    // einfach auf eine fremde Schule setzt (Cross-Tenant), ohne den geheimen
    // Fahrschul-Code zu kennen. Beitreten ist nur MIT korrektem Code möglich.
    function fahrschulCodeStimmt() {
      return exists(/databases/$(database)/documents/fahrschulen/$(request.resource.data.fahrschuleId)) &&
             request.resource.data.get('beitrittCode', '__kein_code__') ==
               get(/databases/$(database)/documents/fahrschulen/$(request.resource.data.fahrschuleId)).data.get('fahrschulCode', '__keine_uebereinstimmung__');
    }

    // ══════════════════════════════════════════════════════
    // SUPERADMINS
    // ══════════════════════════════════════════════════════
    match /superadmins/{uid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════
    // SCHOOLCODES — Nachschlage-Tabelle Code → Fahrschule
    // Zweck: Beim Beitreten findet man die Schule per get(schoolCodes/{code}).
    // Man muss den Code KENNEN, um ihn nachzuschlagen (get). Das massenhafte
    // Auflisten (list) ist gesperrt → kein Abgreifen aller Codes/Schulen.
    // Dadurch kann 'fahrschulen' streng (nur Mitglieder) gelesen werden.
    // ══════════════════════════════════════════════════════
    match /invites/{token} {
      // Einladung per Link: get ist öffentlich (Token = 22 Zeichen Zufall,
      // gleiches Muster wie bookingLinks). Enthält den Fahrschul-Code, damit
      // die bestehende users-Beitritts-Regel greift.
      allow get: if true;
      // Nur die Fahrschule selbst (Fahrschul-ID = UID des Inhabers, siehe
      // create). Vorher genuegte userFsId() - damit sahen auch wartende und
      // gesperrte Mitglieder alle noch offenen Einladungs-Links der Schule
      // und durften sie loeschen.
      allow list: if isAuth() && resource.data.fahrschuleId == request.auth.uid;
      allow create: if isAuth() && userDocExists() && userData().typ == 'fahrschule'
                    && request.resource.data.fahrschuleId == request.auth.uid
                    && request.resource.data.used == false;
      allow update: if isRealAccount() && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.fahrschuleId == resource.data.fahrschuleId
                    && request.resource.data.fahrschulCode == resource.data.fahrschulCode;
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.fahrschuleId == request.auth.uid);
    }
    match /rateLimits/{id} {
      // Versuchszaehler der Cloud Functions (Zugangscode-Suche). Wird
      // ausschliesslich serverseitig per Admin SDK gefuehrt - waere das hier
      // offen, koennte ein Angreifer seinen eigenen Zaehler einfach
      // zuruecksetzen und die Bremse damit aushebeln.
      allow read, write: if false;
    }

    match /oauthStates/{stateId} {
      // Kurzlebiger CSRF-Schutz fuer den Google-Kalender-OAuth-Flow: der
      // Client legt vor der Weiterleitung zu Google einen eigenen Eintrag an,
      // die Cloud Function liest und loescht ihn beim Ruecksprung (Admin SDK,
      // umgeht Rules). Niemand sonst darf ihn lesen.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /calendarTokens/{uid} {
      // Google-OAuth-Tokens fuer den Kalender-Abgleich. Ausschliesslich von
      // den Cloud Functions (Admin SDK) gelesen/geschrieben - niemand sonst,
      // auch nicht der eigene Nutzer, hat direkten Zugriff auf die Tokens.
      allow read, write: if false;
    }

    match /calendarStatus/{uid} {
      // Oeffentlich sichtbarer Verbindungsstatus (ohne die eigentlichen
      // Tokens) - der eigene Nutzer darf nur LESEN, geschrieben wird das nur
      // von den Cloud Functions.
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if false;
    }

    match /fcmTokens/{token} {
      // Geräte-Token für Push-Benachrichtigungen. Gelesen werden sie
      // ausschließlich von den Cloud Functions (Admin SDK, umgeht Rules).
      allow read: if false;
      // Anonyme Schueler-Sitzungen nur mit einem echten Zugangscode: Sonst
      // koennte jede anonyme Sitzung beliebig viele Eintraege anlegen, die
      // der Erinnerungs-Dienst alle 30 Minuten durchgehen muesste.
      allow create, update: if isAuth() && request.resource.data.uid == request.auth.uid &&
                               (isRealAccount() ||
                                (request.resource.data.get('codeId', null) is string &&
                                 exists(/databases/$(database)/documents/accessCodes/$(request.resource.data.codeId))));
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /schoolCodes/{code} {
      // isRealAccount() statt isAuth(): Nachgeschlagen wird ein Code nur beim
      // Beitritt einer Fahrschule - dabei ist man immer mit einem echten
      // Konto angemeldet. Anonyme Schueler-Sitzungen (Zugangscode-Portal)
      // haben hier nichts zu suchen und koennen jetzt nicht mehr genutzt
      // werden, um die Code-Tabelle durchzuprobieren.
      allow get:    if isRealAccount();
      allow list:   if isSuperAdmin();
      // Nur der Inhaber selbst (schoolId == eigene uid) oder SuperAdmin darf
      // einen Code-Eintrag anlegen/ändern. Verhindert das Fälschen von Einträgen.
      // SICHERHEITS-AUDIT (im Emulator nachgewiesen): 'update' pruefte nur
      // den NEUEN Inhalt. Jedes Konto konnte damit den Eintrag einer FREMDEN
      // Schule auf sich selbst umbiegen - wer danach den Code der Schule
      // eingab, landete beim Angreifer statt bei seinem Chef. Aendern darf
      // jetzt nur, wem der Eintrag schon gehoert. Die App legt Eintraege
      // ohnehin nur an, wenn es sie noch nicht gibt (index.html, Selbstheilung).
      allow create: if isSuperAdmin() ||
                       (isRealAccount() && request.resource.data.schoolId == request.auth.uid);
      allow update: if isSuperAdmin() ||
                       (isRealAccount() && resource.data.schoolId == request.auth.uid
                                        && request.resource.data.schoolId == request.auth.uid);
      allow delete: if isSuperAdmin() ||
                       (isAuth() && resource.data.schoolId == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULEN
    // ══════════════════════════════════════════════════════
    match /fahrschulen/{fsId} {
      // READ verschärft: nur SuperAdmin oder MITGLIEDER dieser Fahrschule.
      // Der Beitritts-Code wird NICHT mehr hier gesucht (das läuft über die
      // schoolCodes-Tabelle), daher muss read nicht mehr für alle offen sein.
      // get: eigene Schule (Mitglied) oder SuperAdmin. list: nur SuperAdmin.
      allow get:  if isSuperAdmin() ||
                     (isAuth() && fsId == userFsId());
      allow list: if isSuperAdmin();

      // FIX: 'kalenderAktiv' und alle Abo-Felder waren beim ANLEGEN gar nicht
      // eingeschraenkt (anders als beim spaeteren update) - eine neu
      // angelegte Fahrschule konnte sich so von Anfang an selbst
      // 'kalenderAktiv:true' oder ein Abo setzen, ganz ohne SuperAdmin/
      // Zahlung.
      // SICHERHEITS-AUDIT (im Emulator nachgewiesen): Hier stand
      // "adminUid == eigene uid ODER fsId == eigene uid". Ueber den ersten
      // Zweig konnte jedes Konto unter der Kennung eines FREMDEN
      // eigenstaendigen Fahrlehrers (der noch kein fahrschulen-Dokument hat)
      // eines anlegen - mit status 'gesperrt'. index.html liest genau dieses
      // Dokument als Status des Lehrers und meldet ihn sofort ab: Aussperrung
      // per einem einzigen Schreibvorgang. Beide Registrierungswege legen die
      // Fahrschule unter der eigenen UID an, mit adminUid = eigene UID.
      allow create: if isRealAccount() &&
                       fsId == request.auth.uid &&
                       request.resource.data.adminUid == request.auth.uid &&
                       // Neue Schulen warten auf die Pruefung durch den
                       // Betreiber - beide Registrierungswege schreiben
                       // 'ausstehend'. Selbst 'aktiv' setzen ging bisher.
                       request.resource.data.get('status', 'ausstehend') == 'ausstehend' &&
                       request.resource.data.get('kalenderAktiv', false) == false &&
                       keineAboFelderBeiCreate(request.resource.data);

      // UPDATE: Ein FS-Admin darf seine eigene Fahrschule bearbeiten, ABER
      // 'kalenderAktiv' (bezahltes Extra) und alle Abo-Felder duerfen nur
      // der SuperAdmin bzw. die Cloud Functions (Admin SDK) setzen.
      // SICHERHEITS-AUDIT: Auch 'status' war fuer den Inhaber frei. Damit
      // konnte er seine Schule selbst von 'ausstehend' (wartet auf Pruefung
      // durch den Betreiber) oder 'zahlung_offen' (Zahlungssperre) zurueck
      // auf 'aktiv' setzen. Die App selbst schreibt hier nur eine einzige
      // Statusaenderung: die automatische Zahlungssperre (index.html,
      // 'zahlung_offen'). Nur die bleibt erlaubt - Sperren ja, Entsperren
      // nur durch den Betreiber.
      allow update: if isSuperAdmin() ||
                       (isFsAdmin() && userFsId() == fsId &&
                        (request.resource.data.get('status', null) == resource.data.get('status', null) ||
                         request.resource.data.get('status', null) == 'zahlung_offen') &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false) &&
                        aboFelderUnveraendert(resource.data, request.resource.data) &&
                        loeschmarkerUnveraendert(resource.data, request.resource.data));

      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERS (Fahrlehrer, Admins, SuperAdmin)
    // ══════════════════════════════════════════════════════
    match /users/{uid} {
      // READ: eigenes Doc, SuperAdmin, oder FsAdmin NUR für Mitglieder der
      // EIGENEN Schule (nicht mehr global – sonst könnte ein FsAdmin fremde
      // Nutzerprofile lesen).
      allow read: if isAuth() && (
                    request.auth.uid == uid ||
                    isSuperAdmin() ||
                    (isFsAdmin() && resource.data.fahrschuleId == userFsId())
                  );

      // CREATE: Beim Anlegen des EIGENEN Kontos dürfen sicherheitsrelevante
      // Felder NICHT frei gewählt werden. rolle muss 'fahrlehrer' oder
      // 'fahrschul-admin' sein (NIE superadmin/fs_admin), kalenderAktiv darf
      // nicht aktiv sein, und fahrschuleId nur die eigene uid oder eine Schule
      // mit gültigem Code. status darf 'aktiv' oder 'ausstehend' sein
      // (Selbstheilung bestehender Konten = 'aktiv'; Neu-Registrierung =
      // 'ausstehend'). Ein selbst angelegtes Konto ist ein isolierter
      // Einzel-Lehrer (eigene Daten) – die Schul-Trennung bleibt geschützt.
      allow create: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        isRealAccount() &&
                        request.auth.uid == uid &&
                        request.resource.data.rolle in ['fahrlehrer', 'fahrschul-admin'] &&
                        request.resource.data.get('status', 'ausstehend') in ['aktiv', 'ausstehend'] &&
                        request.resource.data.get('kalenderAktiv', false) == false &&
                        keineAboFelderBeiCreate(request.resource.data) &&
                        (
                          // Eigenes Konto (Einzel-Lehrer/Inhaber): darf sich
                          // selbst 'aktiv' setzen, es sind nur eigene Daten.
                          request.resource.data.fahrschuleId == request.auth.uid ||
                          // SICHERHEITS-AUDIT: Beitritt zu einer FREMDEN Schule
                          // nur als 'ausstehend'. Vorher durfte sich der
                          // Beitretende selbst auf 'aktiv' setzen - wer an den
                          // Fahrschul-Code kam (FS-XXXX, nur ~1 Mio.
                          // Moeglichkeiten und beliebig oft abfragbar), hatte
                          // damit sofort Vollzugriff auf die komplette Kartei
                          // der fremden Schule. Jetzt muss ein Mensch
                          // freischalten - die App legt Beitritte ohnehin
                          // bereits als 'ausstehend' an.
                          // SICHERHEITS-AUDIT: und nur als 'fahrlehrer'. Die
                          // Rolle 'fahrschul-admin' beim Beitritt zu einer
                          // FREMDEN Schule war der Einstieg der Kette, die zum
                          // Vollzugriff fuehrte (siehe isFsAdmin). Die App
                          // legt Beitretende immer als 'fahrlehrer' an.
                          (fahrschulCodeStimmt() &&
                           request.resource.data.status == 'ausstehend' &&
                           request.resource.data.rolle == 'fahrlehrer')
                        )
                      )
                    );

      // UPDATE: Ein Nutzer darf sein eigenes Doc bearbeiten, aber die
      // sicherheitsrelevanten Felder müssen geschützt sein:
      //  • rolle/kalenderAktiv: NIE durch den Nutzer selbst änderbar
      //  • status: nur FsAdmin/SuperAdmin
      //  • fahrschuleId: nur auf die eigene uid (Schule verlassen) ODER auf
      //    eine Schule, deren Code korrekt mitgesendet wird (Beitritt). Das
      //    verhindert Cross-Tenant-Zugriff durch fahrschuleId-Manipulation.
      // FsAdmin darf nur Mitglieder der eigenen Schule bearbeiten.
      allow update: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        (request.auth.uid == uid ||
                         (isFsAdmin() && resource.data.fahrschuleId == userFsId())) &&
                        request.resource.data.rolle == resource.data.rolle &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false) &&
                        aboFelderUnveraendert(resource.data, request.resource.data) &&
                        loeschmarkerUnveraendert(resource.data, request.resource.data) &&
                        // SICHERHEITS-AUDIT (im Emulator nachgewiesen): Hier
                        // stand "isFsAdmin() ||" - und das galt auch fuer das
                        // EIGENE Dokument. Ein Konto, das sich als Fahrschule
                        // registriert (darf jeder, kostenlos), konnte damit
                        // seine fahrschuleId auf eine FREMDE Schule setzen und
                        // sich selbst 'aktiv' schalten - ohne Code, ohne
                        // Freigabe - und las danach deren komplette Kartei.
                        // Die Verwaltungsrechte des Inhabers gelten jetzt nur
                        // noch fuer ANDERE Mitglieder seiner Schule, nie fuer
                        // das eigene Dokument. Fuer sich selbst gelten fuer
                        // ihn dieselben Regeln wie fuer jeden anderen.
                        (
                          (request.auth.uid != uid && isFsAdmin()) ||
                          request.resource.data.get('status', '')
                            == resource.data.get('status', '') ||
                          // Einzige erlaubte Selbst-Aenderung: das Zuruecksetzen
                          // auf 'ausstehend' beim Beitritt zu einer fremden
                          // Schule (siehe unten). Sich selbst HOCHzustufen
                          // bleibt ausgeschlossen.
                          (request.resource.data.status == 'ausstehend' &&
                           fahrschulCodeStimmt())
                        ) &&
                        (
                          // Inhaber gegenueber einem Mitglied: in der Schule
                          // lassen oder hinaus (zurueck auf dessen eigene uid).
                          // Vorher durfte er es in JEDE beliebige Schule
                          // verschieben - ein Mitglied, das er selbst
                          // kontrolliert, also auch in eine fremde, als 'aktiv'.
                          (request.auth.uid != uid && isFsAdmin() &&
                           request.resource.data.fahrschuleId == uid) ||
                          request.resource.data.fahrschuleId == resource.data.fahrschuleId ||
                          request.resource.data.fahrschuleId == request.auth.uid ||
                          // SICHERHEITS-AUDIT: Der nachtraegliche Beitritt zu
                          // einer fremden Schule lief bisher komplett an der
                          // Freigabe vorbei. Die Create-Regel verlangt zwar
                          // 'ausstehend', ein BESTEHENDES Konto mit Status
                          // 'aktiv' konnte seine fahrschuleId aber einfach per
                          // Update auf eine fremde Schule umstellen (Code
                          // genuegt) und behielt dabei 'aktiv' - damit sofort
                          // Vollzugriff auf die fremde Kartei. Ein Wechsel in
                          // eine fremde Schule setzt jetzt zwingend auf
                          // 'ausstehend' zurueck; freischalten kann nur ein
                          // Mensch. Beitreten kann man nur selbst - der
                          // Inhaber kann ein Mitglied nicht in eine andere
                          // Schule schicken.
                          (request.auth.uid == uid &&
                           fahrschulCodeStimmt() &&
                           request.resource.data.status == 'ausstehend')
                        )
                      )
                    );

      // SICHERHEITS-AUDIT: Hier stand nur "isSuperAdmin() || isFsAdmin()".
      // isFsAdmin() prueft allein "ist irgendein Fahrschul-Admin", KEINE
      // Zugehoerigkeit - jeder Fahrschul-Admin konnte damit das Nutzerprofil
      // JEDES Kontos im System loeschen, auch das einer fremden Fahrschule.
      // Wer sein users-Dokument verliert, kommt an nichts mehr heran
      // (userDocExists() steht in fast jeder Regel) - das war also eine
      // Aussperrung per Mausklick, aus einer fremden Fahrschule heraus.
      // Lesen und Aendern pruefen die Zugehoerigkeit oben laengst; beim
      // Loeschen fehlte sie. Jetzt gleichgezogen.
      // ZWEITE PRUEFUNG 11/2026: nur FREMDE Profile (Mitglieder). Das eigene
      // Profil zu loeschen und neu anzulegen hebelte alles aus, was die
      // Update-Regel schuetzt (Sperre, E-Mail-Bestaetigung, Loeschvormerkung)
      // und war ein Glied der Kette in die Kalender fremder Schulen (siehe
      // kalFreigegeben). Das eigene Konto loescht man ueber die Cloud Function.
      allow delete: if isSuperAdmin()
                    || (isFsAdmin() && uid != request.auth.uid
                        && resource.data.fahrschuleId == userFsId());
    }

    // ══════════════════════════════════════════════════════
    // SCHÜLER
    // ══════════════════════════════════════════════════════
    match /students/{studentId} {
      // SuperAdmin darf lesen (nötig zum Auffinden beim Voll-Löschen)
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isRealAccount() &&
                       request.resource.data.uid == request.auth.uid &&
                       fahrschuleIdOkBeiCreate(request.resource.data);
      allow update: if isAuth() && docBelongsToUser(resource.data) &&
                       fahrschuleIdUnveraendert(resource.data, request.resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PROTOKOLL
    // ══════════════════════════════════════════════════════
    match /protokoll/{eintragId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isRealAccount() &&
                       request.resource.data.uid == request.auth.uid &&
                       fahrschuleIdOkBeiCreate(request.resource.data);
      allow update: if isAuth() && docBelongsToUser(resource.data) &&
                       fahrschuleIdUnveraendert(resource.data, request.resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM FIELDS
    // ══════════════════════════════════════════════════════
    match /customFields/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isRealAccount() &&
                       request.resource.data.uid == request.auth.uid &&
                       fahrschuleIdOkBeiCreate(request.resource.data);
      allow update: if isAuth() && docBelongsToUser(resource.data) &&
                       fahrschuleIdUnveraendert(resource.data, request.resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM THEMEN
    // ══════════════════════════════════════════════════════
    match /customThemen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isRealAccount() &&
                       request.resource.data.uid == request.auth.uid &&
                       fahrschuleIdOkBeiCreate(request.resource.data);
      allow update: if isAuth() && docBelongsToUser(resource.data) &&
                       fahrschuleIdUnveraendert(resource.data, request.resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM GRUPPEN (eigene Überschriften im Eigene-Tab)
    // ══════════════════════════════════════════════════════
    match /customGruppen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isRealAccount() &&
                       request.resource.data.uid == request.auth.uid &&
                       fahrschuleIdOkBeiCreate(request.resource.data);
      allow update: if isAuth() && docBelongsToUser(resource.data) &&
                       fahrschuleIdUnveraendert(resource.data, request.resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PASSWORT-RESET ANFRAGEN
    // create OHNE Auth (User ist ausgesperrt!) — streng validiert
    // ══════════════════════════════════════════════════════
    match /passwordResets/{docId} {
      // Nur automatisch vergebene IDs (addDoc). Die ID wird im SuperAdmin-
      // Bereich angezeigt; eine frei gewaehlte ID mit HTML/Skript darin war
      // ein Weg, Code in die Admin-Sitzung einzuschleusen (ohne Login!).
      allow create: if docId.matches('^[A-Za-z0-9]{20}$') &&
                       request.resource.data.keys().hasOnly(['username','kontakt','status','createdAt']) &&
                       request.resource.data.username is string &&
                       request.resource.data.username.size() >= 3 &&
                       request.resource.data.username.size() <= 50 &&
                       request.resource.data.kontakt is string &&
                       request.resource.data.kontakt.size() >= 5 &&
                       request.resource.data.kontakt.size() <= 100 &&
                       request.resource.data.status == 'offen';
      allow read, update, delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // ACCESS CODES (für Schüler-Zugangscodes)
    // ══════════════════════════════════════════════════════
    match /accessCodes/{docId} {
      // SICHERHEIT (Kundenanforderung: Chat streng privat zwischen genau
      // einem Schueler und seinem zugewiesenen Fahrlehrer, auch innerhalb
      // derselben Fahrschule): Die vorherige Fassung liess JEDEN
      // angemeldeten Fahrlehrer/Admin - unabhaengig von Fahrschule oder
      // Zustaendigkeit - per direktem Zugriff auf ein Dokument, dessen
      // Kennung er kannte, lesen/aendern/loeschen. userDocExists() prueft
      // nur "irgendein echtes Konto", keinerlei Zugehoerigkeit. Jetzt
      // zusaetzlich resource.data.teacherUid == request.auth.uid verlangt -
      // nur noch der EINE zustaendige Fahrlehrer (oder SuperAdmin) kommt
      // rein, kein anderer Fahrlehrer/Admin derselben Fahrschule. Der
      // bewusste Schueler-Zugang ueber den Code selbst (ohne Konto) bleibt
      // unveraendert ueber die Ablauf-Bedingungen erhalten.
      // WICHTIG: 'list' bewusst STRENG (nur SuperAdmin/zustaendiger
      // Fahrlehrer) - Firestore-Regeln koennen bei 'list' nur die
      // ZURUECKGEGEBENEN Dokumente pruefen, nicht erzwingen, dass die Anfrage
      // tatsaechlich nach 'code' gefiltert war. Eine Lockerung wie bei 'get'
      // (die nur die Kenntnis EINER Dokument-ID/EINES Codes voraussetzt)
      // wuerde hier stattdessen das listenweise Auflisten ALLER aktiven
      // Zugangscodes (samt Schueler-Stammdaten/Chat) ohne jede Kenntnis
      // erlauben - siehe stattdessen die Cloud Function
      // findeAltenZugangscode fuer den Login-Fallback alter Codes.
      // STUFE 2 (Befund F1/F2, Abschluss): Die beiden letzten Zweige galten
      // bisher OHNE jede Anmeldung. Wer eine gueltige Dokument-Kennung erriet
      // oder in die Finger bekam, las damit Name, Lernstand, Protokoll und
      // Chatverlauf - ganz ohne Konto, mit einem einzigen Aufruf.
      //
      // Das ging nicht frueher zu schliessen: Bis zur Umstellung griff das
      // Schueler-Portal selbst ohne Anmeldung zu. Seit Stufe 1 meldet es sich
      // still an, BEVOR es liest (sitzungSichern() in schueler-portal.html),
      // und der zweite offene Weg - index.html?code=... - leitet dorthin um.
      // Erst dadurch kann isAuth() hier verlangt werden, ohne jemanden
      // auszusperren.
      //
      // Der Schutz bleibt gestuft: isAuth() allein haelt niemanden auf, der
      // sich eine anonyme Sitzung besorgt. Es endet aber der Zugriff voellig
      // ohne Firebase-Sitzung, jeder Zugriff wird zurechenbar, und App Check
      // kann ueberhaupt erst greifen. Die eigentliche Huerde bleibt die
      // Code-Laenge (32^10) samt Bremse auf findeAltenZugangscode.
      allow get:  if isSuperAdmin()
                  || (isAuth() && userDocExists() && resource.data.teacherUid == request.auth.uid)
                  || (isAuth()
                      && (!('expiresAt' in resource.data)
                          || resource.data.expiresAt > request.time.toMillis()));
      allow list: if isSuperAdmin() ||
                     (isAuth() && userDocExists() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAuth() && userDocExists()
                    && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isSuperAdmin()
                    || (isAuth() && userDocExists() && resource.data.teacherUid == request.auth.uid);
      // FIX: 'studentLastRead' fehlte in dieser Liste, obwohl das Portal den
      // Wert beim Lesen der Nachrichten schreibt. Der Schreibvorgang wurde
      // deshalb immer abgewiesen (und im Client stillschweigend
      // weggefangen) - der Ungelesen-Zaehler des Schuelers konnte nie
      // zuruecksetzen. Gegenstueck zu 'teacherLastRead', das der Fahrlehrer
      // ueber den regulaeren Lehrer-Zweig oben schreibt.
      // STUFE 2: derselbe Zusatz wie beim Lesen. Ohne ihn konnte jeder, der
      // die Kennung kannte, in den Chat des Schuelers schreiben.
      allow update: if isSuperAdmin()
                    || (isAuth() && userDocExists() && resource.data.teacherUid == request.auth.uid)
                    || (isAuth()
                        && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['messages', 'plannedLessons', 'lernziele', 'studentLastRead'])
                        && (!('expiresAt' in resource.data)
                            || resource.data.expiresAt > request.time.toMillis()));
    }

    match /studentSessions/{uid} {
      allow read:   if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid && !userDocExists();
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════
    // CHAT
    // ══════════════════════════════════════════════════════
    match /chat/{msgId} {
      // SICHERHEITS-AUDIT (im Emulator nachgewiesen): Hier genuegte
      // "fahrschuleId == userFsId()". Ein GESPERRTES Mitglied las damit den
      // Team-Chat der Schule weiter mit, und wer den Fahrschul-Code kannte,
      // trat bei und las ihn schon, waehrend er noch auf Freigabe wartete.
      // Jetzt dieselbe Freigabe-Bedingung wie bei der Kartei.
      allow read:   if isAuth() && schulMitglied(resource.data.fahrschuleId);
      allow create: if isAuth() &&
                       request.resource.data.senderUid == request.auth.uid &&
                       schulMitglied(request.resource.data.fahrschuleId);
      allow update: if false;
      allow delete: if isAuth() &&
                       resource.data.senderUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // PLATFORM (Impressum, Einstellungen)
    // ══════════════════════════════════════════════════════
    match /platform/{docId} {
      // Impressum/Broadcast/Werbung werden gezielt per get() geladen (das
      // Impressum MUSS öffentlich sein – rechtliche Pflicht). list() ist
      // gesperrt.
      // SICHERHEITS-AUDIT: 'if true' galt vorher fuer JEDES Dokument dieser
      // Sammlung - also auch fuer 'rechnungszaehler', den fortlaufenden
      // Rechnungszaehler. Der war damit oeffentlich abrufbar und verriet
      // jedem, wie viele Rechnungen insgesamt gestellt wurden. Kein Client
      // liest ihn, nur die Cloud Functions (Admin SDK) - deshalb jetzt auf
      // die drei tatsaechlich oeffentlichen Dokumente eingegrenzt.
      allow get:   if docId in ['impressum', 'broadcast', 'werbung'];
      // NACHTRAG (im Emulator nachgewiesen): Die Eingrenzung oben war
      // wirkungslos, solange 'list' fuer jeden Angemeldeten offen stand -
      // auch fuer anonyme Schueler-Sitzungen. Eine Abfrage der ganzen
      // Sammlung lieferte den Rechnungszaehler trotzdem. Keine Seite listet
      // diese Sammlung; alle laden gezielt per get().
      allow list:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERNAMES (Benutzername → E-Mail Zuordnung für Login)
    // Öffentlich lesbar, damit Login per Benutzername funktioniert.
    // Enthält KEINE sensiblen Daten (nur username, email, uid).
    // ══════════════════════════════════════════════════════
    match /rechnungen/{docId} {
      // Nur lesbar fuer den Rechnungsempfaenger selbst oder den SuperAdmin.
      // Geschrieben wird ausschliesslich serverseitig per Cloud Function
      // (Admin SDK umgeht diese Regeln ohnehin) - kein Client darf je
      // eine eigene Rechnung erzeugen oder veraendern.
      allow read:  if isSuperAdmin() ||
                      (isAuth() && resource.data.empfaengerId == request.auth.uid);
      allow write: if false;
    }

    match /usernames/{uname} {
      // get() für den Login-Lookup (Benutzername ist Doc-ID) ist erlaubt.
      // SICHERHEIT/DSGVO-FIX: Der alte Kommentar behauptete, list() sei
      // gesperrt - die Regel darunter erlaubte es aber jedem Angemeldeten
      // (auch anonymen Schüler-Sitzungen): alle Benutzernamen samt
      // E-Mail-Adressen aller Kunden waren abfragbar. Jetzt wirklich zu;
      // keine App-Funktion nutzt diese Abfrage.
      allow get:    if true;
      allow list:   if isSuperAdmin();
      // isRealAccount(): Benutzernamen gehoeren zu echten Konten. Anonyme
      // Schueler-Sitzungen konnten sonst beliebig viele Namen belegen.
      allow create: if isRealAccount() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULKALENDER (separates App, gemeinsames Projekt)
    // Eigene Collections, eigenes Rollensystem (role/approved/schoolId).
    // kalenderUsers ist getrennt von ADKs users, damit keine Kollision.
    // ══════════════════════════════════════════════════════
    function kalAuth() { return request.auth != null; }
    function kalIsSuperAdmin() {
      return kalAuth() && request.auth.token.email == 'chriskoo@mail.de';
    }
    // Existiert mein Kalender-Profil? (Schutz vor get() auf nicht-existentes Doc)
    function kalUserExists() {
      return kalAuth() && exists(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid));
    }
    // Meine eigene Schul-ID (aus meinem kalenderUsers-Profil)
    function kalMySchool() {
      return get(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid)).data.schoolId;
    }
    // SICHERHEITS-AUDIT (im Emulator nachgewiesen): Der Kalender kannte die
    // Freigabe gar nicht. Die schoolId im Kalender-Profil folgt der
    // fahrschuleId aus users - und die zeigt schon beim BEITRITT auf die
    // Schule, also waehrend man noch auf Freigabe wartet. Wer den
    // Fahrschul-Code kannte, sah damit sofort alle Termine, Schueler und
    // Pruefungen der Schule; ein GESPERRTES Mitglied ebenso weiterhin.
    // Jetzt gilt dieselbe Bedingung wie in der Kartei: die eigene Schule
    // immer, eine fremde nur mit Freigabe.
    function kalFreigegeben(sid) {
      // FIX: Zusaetzlich muss die Schule zur Kartei-Zuordnung passen. Vorher
      // behielt ein Fahrlehrer, der die Fahrschule verlassen hat (users.
      // fahrschuleId zeigt wieder auf ihn selbst), ueber sein altes Kalender-
      // Profil vollen Zugriff auf Termine, Schueler und Notizen der Schule.
      //
      // ZWEITE PRUEFUNG 11/2026: Hier stand zusaetzlich "|| !userDocExists()"
      // (Konten ohne Kartei-Profil galten als freigegeben). Das war ein Weg
      // in JEDE fremde Schule, deren Fahrschul-Code man kennt: als Fahrschule
      // registrieren, mit dem Code "beitreten" (wartend), das Kalender-Profil
      // auf die fremde Schule anlegen, das eigene Kartei-Profil wieder
      // loeschen - danach griff die Ausnahme und der Kalender der fremden
      // Schule (Namen, Telefonnummern, Termine) stand offen. Der Kalender
      // selbst laesst Konten ohne Kartei-Profil ohnehin nicht hinein
      // ("Kein ADK-Konto gefunden") - die Ausnahme schuetzte also niemanden.
      return sid == request.auth.uid ||
             (userDocExists() && userFsId() == sid && istFreigegeben());
    }
    // Ist dieses Konto laut KARTEI ein freigegebenes Mitglied der Schule?
    // (Das Kalender-Profil allein genuegt nicht - es bleibt nach einem
    // Austritt stehen, bis der Betreffende den Kalender wieder oeffnet.)
    function kalIstMitglied(luid, sid) {
      return exists(/databases/$(database)/documents/users/$(luid)) &&
             get(/databases/$(database)/documents/users/$(luid)).data.get('fahrschuleId', luid) == sid &&
             get(/databases/$(database)/documents/users/$(luid)).data.get('status', 'aktiv') != 'ausstehend' &&
             get(/databases/$(database)/documents/users/$(luid)).data.get('status', 'aktiv') != 'gesperrt';
    }
    // Gehört ein Dokument mit dieser schoolId zu MEINER Schule? (oder bin ich SuperAdmin)
    function kalOwnsSchool(sid) {
      return kalIsSuperAdmin() ||
             (sid is string && kalUserExists() && kalMySchool() == sid && kalFreigegeben(sid));
    }

    // ── Anlegen/Aendern in den Kalender-Sammlungen ──
    // SICHERHEITS-AUDIT 11/2026: Anlegen war erlaubt, wenn ENTWEDER die
    // schoolId zur eigenen Schule gehoerte (dann mit beliebiger lehrerUid)
    // ODER die lehrerUid die eigene war (dann mit beliebiger schoolId).
    // Damit konnte jedes kostenlose Konto Schueler, Termine und Theorie-
    // Eintraege in den Kalender FREMDER Schulen bzw. fremder Fahrlehrer
    // schreiben (bis hin zu eingeschleustem Code). Jetzt muessen BEIDE
    // passen: die Schule ist meine (Kalender-Profil oder Kartei-
    // Mitgliedschaft mit Freigabe, Solo = eigene uid) UND die lehrerUid bin
    // ich oder ein Kollege meiner Schule. Gilt auch fuer den neuen Stand
    // beim Aendern, damit niemand ein eigenes Dokument in eine fremde Schule
    // "umzieht".
    function kalKollege(luid) {
      // ... und laut Kartei noch Mitglied: Einem ausgetretenen Fahrlehrer
      // (altes Kalender-Profil) kann niemand mehr Schueler oder Termine
      // zuweisen - er koennte sie sonst weiter lesen.
      return kalUserExists() && kalMySchool() is string && kalFreigegeben(kalMySchool()) &&
             exists(/databases/$(database)/documents/kalenderUsers/$(luid)) &&
             get(/databases/$(database)/documents/kalenderUsers/$(luid)).data.schoolId == kalMySchool() &&
             kalIstMitglied(luid, kalMySchool());
    }
    // Lehrer: keiner, ich selbst oder ein Kollege meiner Kalender-Schule
    function kalLehrerOk(d) {
      return d.get('lehrerUid', null) == null || d.get('lehrerUid', null) == request.auth.uid ||
             kalKollege(d.get('lehrerUid', null));
    }
    // Schule: meine Kalender-Schule, meine Kartei-Schule (mit Freigabe),
    // meine eigene Kennung, oder ohne Schule nur fuer eigene Eintraege
    function kalSchuleOk(d) {
      return kalOwnsSchool(d.get('schoolId', null)) ||
             (isRealAccount() && (d.get('schoolId', null) == request.auth.uid ||
                                  schulMitglied(d.get('schoolId', null)))) ||
             (isRealAccount() && d.get('schoolId', null) == null &&
              d.get('lehrerUid', null) == request.auth.uid);
    }
    function kalSchreibOk(d) {
      return kalIsSuperAdmin() || (kalLehrerOk(d) && kalSchuleOk(d));
    }
    // Beim AENDERN darf die bisherige Zuordnung stehen bleiben: Sonst liesse
    // sich ein Dokument, das noch einem ausgetretenen Fahrlehrer zugeordnet
    // ist, gar nicht mehr bearbeiten (auch nicht, um es neu zuzuordnen -
    // dafuer wird die lehrerUid ja geaendert und dann wieder geprueft).
    function kalAendernOk(alt, neu) {
      return kalIsSuperAdmin() || (
        (neu.get('lehrerUid', null) == alt.get('lehrerUid', null) || kalLehrerOk(neu)) &&
        kalSchuleOk(neu));
    }
    // Neue Dokumente nur mit automatisch vergebener ID (addDoc). Die IDs
    // landen in onclick-Attributen der Oberflaeche.
    function kalIdOk(id) { return id.matches('^[A-Za-z0-9_-]{1,64}$'); }

    // Die ADK-fahrschuleId des Nutzers (autoritativ, da users.rolle jetzt
    // geschützt ist). Wird genutzt, um die Kalender-schoolId fest an die
    // echte Identität zu binden – so kann niemand eine fremde schoolId wählen.
    function kalAdkFahrschuleId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fahrschuleId
        : null;
    }

    // Kalender-Nutzerprofile: eigenes Doc immer; fremde nur in eigener Schule.
    // WICHTIG: Beim Anlegen/Ändern des eigenen Profils muss die schoolId mit
    // der ADK-fahrschuleId übereinstimmen (oder SuperAdmin) – verhindert, dass
    // sich jemand einer fremden Fahrschule zuordnet (Cross-Tenant-Schutz).
    match /kalenderUsers/{uid} {
      allow read:   if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid) ||
                       (kalUserExists() && resource.data.schoolId == kalMySchool()
                                        && kalFreigegeben(kalMySchool()));
      // schoolId muss eine echte Kennung sein: Ohne Kartei-Profil ist
      // kalAdkFahrschuleId() null - mit "schoolId: null" liess sich sonst ein
      // Kalender-Profil der "Schule null" anlegen (Zugriff auf alle
      // Dokumente, deren schoolId ausdruecklich null ist).
      allow create: if kalIsSuperAdmin() ||
                       (isRealAccount() && request.auth.uid == uid &&
                        request.resource.data.schoolId is string &&
                        request.resource.data.schoolId == kalAdkFahrschuleId());
      allow update: if kalIsSuperAdmin() ||
                       (isRealAccount() && request.auth.uid == uid &&
                        request.resource.data.schoolId is string &&
                        request.resource.data.schoolId == kalAdkFahrschuleId()) ||
                       // Der Inhaber (Fahrschul-ID = seine uid) stellt fuer
                       // seine Fahrlehrer die Blockdauer ein. Vorher verbot
                       // die Regel das - die Auswahl im Kalender zeigte nur
                       // einen Rechtefehler.
                       (isRealAccount() && uid != request.auth.uid &&
                        resource.data.schoolId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockDauer']));
      allow delete: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid);
    }

    // Fahrschulen im Kalender: nur die eigene
    match /schools/{schoolId} {
      allow read:   if kalOwnsSchool(schoolId);
      // Nur unter der EIGENEN Kennung (Fahrschul-ID = UID des Inhabers).
      // Vorher genuegte adminUid == eigene uid - damit konnte jedes Konto
      // unter der Kennung einer fremden Schule ein Kalender-Schulprofil
      // anlegen, solange dort noch keines lag, und deren Mitgliedern einen
      // falschen Schulnamen unterschieben. Kein Programmteil legt hier an.
      allow create: if kalIsSuperAdmin() ||
                       (isRealAccount() && schoolId == request.auth.uid &&
                        request.resource.data.adminUid == request.auth.uid);
      // Nur der Inhaber (vorher jedes freigegebene Mitglied - das konnte
      // damit Namen, Berechtigungen und Fahrstundenarten der Schule aendern).
      allow update: if kalIsSuperAdmin() ||
                       (isRealAccount() && schoolId == request.auth.uid);
      allow delete: if kalIsSuperAdmin();
    }

    // ── Daten-Collections mit schoolId: streng pro Fahrschule getrennt ──
    // read/update/delete prüfen die schoolId des BESTEHENDEN Dokuments,
    // create prüft die schoolId des NEUEN Dokuments. So kann niemand Daten
    // einer fremden Fahrschule lesen, ändern oder unterschieben.
    match /schueler/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /slots/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
      // Schüler-Selbststorno (OHNE Login): NUR den eigenen gebuchten Termin
      // freigeben (bookedBy -> null). Eng begrenzt:
      //  - nur wenn aktuell gebucht und neuer Wert null
      //  - die angegebene Schüler-ID muss == aktuell Gebuchter sein (Nachweis)
      //  - es dürfen NUR diese Felder geändert werden
      //  - nur, wenn der Termin noch mehr als 48 Std. entfernt ist (serverseitig)
      allow update: if resource.data.bookedBy != null
                    && request.resource.data.bookedBy == null
                    && request.resource.data.storniertVonSchueler == resource.data.bookedBy
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedBy','bookedAt','storniertVonSchueler','storniertAt'])
                    && resource.data.startTime is timestamp
                    && resource.data.startTime > request.time + duration.value(48, 'h');
    }

    // NEU: Theorie-Unterricht (Gruppensitzungen) fuer den amtlichen
    // Ausbildungsnachweis (Anlage 3) - dieselbe Zustaendigkeits-Pruefung
    // wie bei slots.
    match /theorieStunden/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /autos/{docId} {
      // FIX: Solo-Fahrlehrer (keine Fahrschul-Mitgliedschaft/kalenderUsers-
      // Zuordnung noetig) konnten hier nie verwalten, da anders als bei
      // schueler/slots/urlaub/... der Rueckfallweg ueber die eigene lehrerUid
      // fehlte - kalOwnsSchool() allein greift nur mit korrekter
      // Fahrschul-Mitgliedschaft.
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /globalBlocked/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /urlaub/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /notizen/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    match /warteliste/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId) || (isAuth() && resource.data.lehrerUid == request.auth.uid))
                             && kalAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalSchreibOk(request.resource.data);
    }
    // SICHERHEITS-AUDIT (Datenverlust): Diese Regel fragte nach 'lehrerUid' -
    // ein Feld, das pruefungen GAR NICHT fuehrt. Der Client schreibt den
    // Erfasser als 'eingetragenVon'. Der Zweig war damit fuer jedes echte
    // Dokument tot, uebrig blieb allein kalOwnsSchool(schoolId).
    // Folge: Ein Fahrlehrer legt Pruefungstermine an (schoolId = seine eigene
    // uid), tritt spaeter einer Fahrschule bei - ab da zeigt sein
    // Kalender-Profil auf die Schule, und seine ALTEN Pruefungen waren fuer
    // ihn unsichtbar. Nicht geloescht, aber nicht mehr erreichbar, was fuer
    // ihn dasselbe ist.
    // 'lehrerUid' bleibt der Vollstaendigkeit halber stehen; .get() mit
    // Vorgabe statt Direktzugriff, damit ein fehlendes Feld die Auswertung
    // nicht in einen Fehler laufen laesst.
    // Pruefungen: wie kalSchreibOk, der Erfasser steht in 'eingetragenVon'
    // (ohne Schule nur fuer eigene Eintraege).
    function kalPruefungSchuleOk(d) {
      return kalOwnsSchool(d.get('schoolId', null)) ||
             (isRealAccount() && (d.get('schoolId', null) == request.auth.uid ||
                                  schulMitglied(d.get('schoolId', null)))) ||
             (isRealAccount() && d.get('schoolId', null) == null &&
              (d.get('lehrerUid', null) == request.auth.uid || d.get('eingetragenVon', null) == request.auth.uid));
    }
    function kalPruefungOk(d) {
      return kalIsSuperAdmin() || (kalLehrerOk(d) && kalPruefungSchuleOk(d));
    }
    function kalPruefungAendernOk(alt, neu) {
      return kalIsSuperAdmin() || (
        (neu.get('lehrerUid', null) == alt.get('lehrerUid', null) || kalLehrerOk(neu)) &&
        kalPruefungSchuleOk(neu));
    }
    match /pruefungen/{docId} {
      allow read, delete: if kalOwnsSchool(resource.data.schoolId)
                          || (isAuth() && resource.data.get('lehrerUid', '') == request.auth.uid)
                          || (isAuth() && resource.data.get('eingetragenVon', '') == request.auth.uid);
      allow update:       if (kalOwnsSchool(resource.data.schoolId)
                              || (isAuth() && resource.data.get('lehrerUid', '') == request.auth.uid)
                              || (isAuth() && resource.data.get('eingetragenVon', '') == request.auth.uid))
                             && kalPruefungAendernOk(resource.data, request.resource.data);
      allow create:       if kalIdOk(docId) && kalPruefungOk(request.resource.data);
    }
    // blocked hat kein schoolId, nur lehrerUid → über den Lehrer absichern
    // ZWEITE PRUEFUNG 11/2026: Sperrzeiten tragen den Grund der Abwesenheit
    // ("Krank", "Arzt", eigene Notiz). Bisher durfte JEDES Mitglied der Schule
    // die Sperrzeiten aller Kollegen lesen, aendern und loeschen. Die App
    // braucht nur zwei Wege: der Fahrlehrer seine eigenen, der Inhaber die
    // seiner Fahrlehrer (Kalender-Ansicht im Admin-Bereich).
    function kalSperreDarf(luid) {
      return kalIsSuperAdmin() ||
             (isRealAccount() && luid == request.auth.uid) ||
             (isRealAccount() && luid is string &&
              exists(/databases/$(database)/documents/kalenderUsers/$(luid)) &&
              get(/databases/$(database)/documents/kalenderUsers/$(luid)).data.schoolId == request.auth.uid);
    }
    match /blocked/{docId} {
      allow read, delete: if kalSperreDarf(resource.data.lehrerUid);
      // Die Sperre bleibt beim selben Fahrlehrer
      allow update:       if kalSperreDarf(resource.data.lehrerUid)
                             && request.resource.data.lehrerUid == resource.data.lehrerUid;
      allow create:       if kalIdOk(docId) && kalSperreDarf(request.resource.data.lehrerUid);
    }
    // mailQueue: enthält E-Mail-Inhalte (personenbezogen). Jeder eingeloggte
    // Nutzer darf eine Mail EINREIHEN (create), aber nur SuperAdmin/System
    // darf den Inhalt LESEN. Kein Lesen durch normale Nutzer.
    // ZWEITE PRUEFUNG 11/2026: Die Warteschlange wird nicht mehr beschrieben.
    // Benachrichtigungen entstehen jetzt auf dem Server aus der Aenderung am
    // Termin selbst (functions/mail.js) - Empfaenger und Inhalt kommen nie
    // mehr aus dem Browser. Der Block bleibt fuer das Aufraeumen von Altbestand.
    match /mailQueue/{docId} {
      allow create: if false;
      allow read:   if kalIsSuperAdmin();
      allow update, delete: if kalIsSuperAdmin();
    }
    // App-Einstellungen: lesen alle Eingeloggten, schreiben nur SuperAdmin
    match /settings/{docId} {
      allow read:  if kalAuth();
      allow write: if kalIsSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // VARIANTE C – Sichere Schüler-Buchung per Link (OHNE Login)
    // ══════════════════════════════════════════════════════
    // bookingLinks/{lehrerUid}: öffentlicher Schnappschuss der FREIEN Termine
    //   eines Lehrers (lehrerName, schoolName, freieSlots). KEINE Schülerdaten,
    //   KEINE gebuchten Slots. get per ID erlaubt (Link kennt die UID),
    //   list gesperrt (keine Enumeration). Schreiben nur der Lehrer selbst.
    match /bookingLinks/{lehrerUid} {
      allow get:    if true;
      allow list:   if false;
      allow create, update, delete: if isAuth() && request.auth.uid == lehrerUid;
      // Der INHABER veroeffentlicht die freien Termine eines Fahrlehrers
      // seiner Schule. Ohne das zeigte ein Buchungslink, den der Inhaber aus
      // der Schuelerliste kopierte, nichts an (und Warteliste/Nachrichten
      // gingen nicht), solange der Fahrlehrer den Link nicht selbst einmal
      // geteilt hatte. Nur fuer freigeschaltete Mitglieder der eigenen Schule.
      allow create, update: if isRealAccount()
                            && lehrerUid != request.auth.uid
                            && kalIstMitglied(lehrerUid, request.auth.uid)
                            && request.resource.data.lehrerUid == lehrerUid
                            && request.resource.data.schoolId == request.auth.uid;
    }
    // bookingStudents/{schuelerId}: nur Vorname + lehrerUid (für die Begrüßung).
    //   get per ID (Link kennt die zufällige Schüler-ID), list gesperrt.
    //   Anlegen durch den eigenen Lehrer; Ändern/Löschen nur durch den Lehrer,
    //   dem das Doc bereits gehört (verhindert Übernahme fremder Links).
    match /bookingWaitlist/{schuelerId} {
      // Schüler liest eigenen Status (per ID); Lehrer listet eigene Einträge.
      allow get:    if true;
      allow list:   if isAuth() && resource.data.lehrerUid == request.auth.uid;
      allow update: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // Austragen: Schüler (kennt eigene schuelerId) oder Lehrer.
      allow delete: if true;
      // Eintragen (ohne Login): nur für aktiven Buchungs-Link, eigene ID, Status 'wartend'.
      // Die ID ist die Kalender-Schueler-ID aus dem Buchungslink - nur
      // automatisch vergebene IDs, und der Schueler muss zu diesem Lehrer
      // gehoeren (vorher konnte jeder ohne Login beliebige IDs anlegen).
      allow create: if request.resource.data.status == 'wartend'
                    && schuelerId.matches('^[A-Za-z0-9_-]{1,64}$')
                    && exists(/databases/$(database)/documents/bookingStudents/$(schuelerId))
                    && get(/databases/$(database)/documents/bookingStudents/$(schuelerId)).data.lehrerUid == request.resource.data.lehrerUid
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId == schuelerId
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','vorname','status','createdAt'])
                    && request.resource.data.keys().hasOnly(['lehrerUid','schuelerId','vorname','notiz','status','createdAt'])
                    && request.resource.data.vorname is string
                    && request.resource.data.vorname.size() <= 60
                    && request.resource.data.get('notiz', '') is string
                    && request.resource.data.get('notiz', '').size() <= 500
                    && exists(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid))
                    && get(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid)).data.aktiv == true;
    }
    match /bookingStudents/{schuelerId} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuth() && request.resource.data.lehrerUid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // UEBERNEHMEN durch den aktuellen Fahrlehrer des Schuelers. Zwei Faelle
      // liessen den Buchungslink sonst fuer immer scheitern:
      //  - Das Dokument hat (aus einer frueheren Fassung von syncBookedCount)
      //    gar keine lehrerUid.
      //  - Der Schueler wurde einem anderen Fahrlehrer zugeteilt: Das Dokument
      //    gehoerte weiter dem alten, der neue durfte es nicht beschreiben.
      // Massgeblich ist, wem der Kalender-Schueler JETZT zugeordnet ist.
      allow update: if isRealAccount()
                    && request.resource.data.lehrerUid == request.auth.uid
                    && exists(/databases/$(database)/documents/schueler/$(schuelerId))
                    && get(/databases/$(database)/documents/schueler/$(schuelerId)).data.lehrerUid == request.auth.uid;
      // Der INHABER legt den Buchungslink fuer einen Schueler seiner Schule an
      // (Symbol 🔗 in der Schuelerliste) - immer auf den Fahrlehrer, dem der
      // Schueler zugeordnet ist, nie auf jemand anderen.
      allow create, update: if isRealAccount()
                    && exists(/databases/$(database)/documents/schueler/$(schuelerId))
                    && get(/databases/$(database)/documents/schueler/$(schuelerId)).data.schoolId == request.auth.uid
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.lehrerUid == get(/databases/$(database)/documents/schueler/$(schuelerId)).data.lehrerUid;
      // Schüler darf (ohne Login) NUR die eigene Terminliste anpassen – z.B.
      // nach einem Selbststorno. lehrerUid/vorname bleiben gesperrt.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meineTermine','updatedAt'])
                    && request.resource.data.lehrerUid == resource.data.lehrerUid;
    }
    // bookingRequests/{id}: Terminanfragen der Schüler.
    //   Schüler DARF anlegen (ohne Login), aber NICHT lesen → kein Abgriff.
    //   create nur mit Pflichtfeldern UND wenn ein realer, AKTIVER Buchungslink
    //   des Lehrers existiert (bindet Anfrage an echte Verknüpfung, bremst Spam).
    //   Lesen/Ändern/Löschen ausschließlich der betroffene Lehrer.
    match /bookingRequests/{reqId} {
      allow read:   if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // ZWEITE PRUEFUNG 11/2026: Ohne Login anlegbar - deshalb nur bekannte
      // Felder, kurze Texte und einfache Kennungen. Der Vorname wird beim
      // Fahrlehrer angezeigt; er stand dort ungeschuetzt im Tagesfenster
      // (eingeschleuster Code lief in der Sitzung des Fahrlehrers).
      allow create: if request.resource.data.status == 'angefragt'
                    && reqId.matches('^[A-Za-z0-9]{20}$')
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','slotId','start','ende','status'])
                    && request.resource.data.keys().hasOnly(['lehrerUid','schuelerId','vorname','slotId','swapSlotId','start','ende','type','status','tausch','createdAt'])
                    && request.resource.data.schuelerId.matches('^[A-Za-z0-9_-]{1,64}$')
                    && request.resource.data.slotId is string
                    && request.resource.data.slotId.matches('^[A-Za-z0-9_-]{1,64}$')
                    && request.resource.data.get('swapSlotId', 'x').matches('^[A-Za-z0-9_-]{1,64}$')
                    && request.resource.data.get('vorname', '') is string
                    && request.resource.data.get('vorname', '').size() <= 60
                    && request.resource.data.start is string && request.resource.data.start.size() <= 40
                    && request.resource.data.ende is string && request.resource.data.ende.size() <= 40
                    && request.resource.data.get('type', '') is string
                    && request.resource.data.get('type', '').size() <= 40
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId is string
                    && exists(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid))
                    && get(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid)).data.aktiv == true;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // ALLES ANDERE: VERBOTEN
    // ══════════════════════════════════════════════════════
    match /bookingMessages/{msgId} {
      // Lehrer liest/verwaltet eigene Nachrichten; Schüler liest NICHT.
      allow read:           if isAuth() && resource.data.lehrerUid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // Schüler (ohne Login) darf NUR senden – und nur, wenn die schuelerId
      // ein echter, vom Lehrer angelegter Link ist (Anti-Spam) + Längenlimit.
      allow create: if request.resource.data.status == 'neu'
                    && msgId.matches('^[A-Za-z0-9]{20}$')
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','vorname','text','status','createdAt'])
                    && request.resource.data.keys().hasOnly(['lehrerUid','schuelerId','vorname','text','status','createdAt'])
                    && request.resource.data.vorname is string
                    && request.resource.data.vorname.size() <= 60
                    && exists(/databases/$(database)/documents/bookingStudents/$(request.resource.data.schuelerId))
                    && get(/databases/$(database)/documents/bookingStudents/$(request.resource.data.schuelerId)).data.lehrerUid == request.resource.data.lehrerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
