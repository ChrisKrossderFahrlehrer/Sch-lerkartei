// ╔══════════════════════════════════════════════════════════════════╗
// ║   ADK – DIGITALE KARTEI · Firestore-Sicherheitsregeln              ║
// ║   © 2026 ChrisKross der Fahrlehrer (Chriskoo)                      ║
// ║   fahrsync.de · Kontakt: kontakt@fahrsync.de                 ║
// ║                                                                    ║
// ║   ─────────────── ALLE RECHTE VORBEHALTEN ───────────────         ║
// ║                                                                    ║
// ║   Diese Sicherheitsregeln und der gesamte zugehörige Quellcode     ║
// ║   sind urheberrechtlich geschützt (§ 69a ff. UrhG). Das Urheber-   ║
// ║   recht liegt ausschließlich beim Entwickler.                      ║
// ║                                                                    ║
// ║   Das Kopieren, Nachbauen, Verbreiten oder Wiederverwenden –       ║
// ║   auch in Teilen – ist streng verboten und wird zivil- und         ║
// ║   strafrechtlich verfolgt (§ 106 UrhG: Freiheitsstrafe bis zu      ║
// ║   3 Jahren oder Geldstrafe; §§ 97 ff. UrhG: Schadensersatz).       ║
// ╚══════════════════════════════════════════════════════════════════╝

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════
    // HILFSFUNKTIONEN
    // ══════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'chriskoo@mail.de' ||
        (userDocExists() && userData().rolle == 'superadmin') ||
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid))
      );
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userFsId() {
      return userDocExists() ? userData().fahrschuleId : request.auth.uid;
    }

    function isFsAdmin() {
      // FIX: Rolle wird ueberall als 'fahrschul-admin' gespeichert, nicht 'fs_admin'.
      // Ohne diesen Fix war isFsAdmin() IMMER false (Tippfehler-Bug).
      return isAuth() && userDocExists() && userData().rolle == 'fahrschul-admin';
    }

    // Helper: Dokument gehört zum User (neue oder alte Struktur)
    function docBelongsToUser(resData) {
      return resData.fahrschuleId == userFsId() ||
             resData.uid == request.auth.uid;
    }

    // Helper: Stimmt der beim Beitritt mitgesendete Code mit dem Code der
    // Ziel-Fahrschule überein? Verhindert, dass jemand seine fahrschuleId
    // einfach auf eine fremde Schule setzt (Cross-Tenant), ohne den geheimen
    // Fahrschul-Code zu kennen. Beitreten ist nur MIT korrektem Code möglich.
    function fahrschulCodeStimmt() {
      return exists(/databases/$(database)/documents/fahrschulen/$(request.resource.data.fahrschuleId)) &&
             request.resource.data.get('beitrittCode', '__kein_code__') ==
               get(/databases/$(database)/documents/fahrschulen/$(request.resource.data.fahrschuleId)).data.get('fahrschulCode', '__keine_uebereinstimmung__');
    }

    // ══════════════════════════════════════════════════════
    // SUPERADMINS
    // ══════════════════════════════════════════════════════
    match /superadmins/{uid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════
    // SCHOOLCODES — Nachschlage-Tabelle Code → Fahrschule
    // Zweck: Beim Beitreten findet man die Schule per get(schoolCodes/{code}).
    // Man muss den Code KENNEN, um ihn nachzuschlagen (get). Das massenhafte
    // Auflisten (list) ist gesperrt → kein Abgreifen aller Codes/Schulen.
    // Dadurch kann 'fahrschulen' streng (nur Mitglieder) gelesen werden.
    // ══════════════════════════════════════════════════════
    match /invites/{token} {
      // Einladung per Link: get ist öffentlich (Token = 22 Zeichen Zufall,
      // gleiches Muster wie bookingLinks). Enthält den Fahrschul-Code, damit
      // die bestehende users-Beitritts-Regel greift.
      allow get: if true;
      allow list: if isAuth() && resource.data.fahrschuleId == userFsId();
      allow create: if isAuth() && userDocExists() && userData().typ == 'fahrschule'
                    && request.resource.data.fahrschuleId == request.auth.uid
                    && request.resource.data.used == false;
      allow update: if isAuth() && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.fahrschuleId == resource.data.fahrschuleId
                    && request.resource.data.fahrschulCode == resource.data.fahrschulCode;
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.fahrschuleId == userFsId());
    }
    match /fcmTokens/{token} {
      // Geräte-Token für Push-Benachrichtigungen. Gelesen werden sie
      // ausschließlich von den Cloud Functions (Admin SDK, umgeht Rules).
      allow read: if false;
      allow create, update: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /schoolCodes/{code} {
      allow get:    if isAuth();
      allow list:   if isSuperAdmin();
      // Nur der Inhaber selbst (schoolId == eigene uid) oder SuperAdmin darf
      // einen Code-Eintrag anlegen/ändern. Verhindert das Fälschen von Einträgen.
      allow create, update: if isSuperAdmin() ||
                               (isAuth() && request.resource.data.schoolId == request.auth.uid);
      allow delete: if isSuperAdmin() ||
                       (isAuth() && resource.data.schoolId == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULEN
    // ══════════════════════════════════════════════════════
    match /fahrschulen/{fsId} {
      // READ verschärft: nur SuperAdmin oder MITGLIEDER dieser Fahrschule.
      // Der Beitritts-Code wird NICHT mehr hier gesucht (das läuft über die
      // schoolCodes-Tabelle), daher muss read nicht mehr für alle offen sein.
      // get: eigene Schule (Mitglied) oder SuperAdmin. list: nur SuperAdmin.
      allow get:  if isSuperAdmin() ||
                     (isAuth() && fsId == userFsId());
      allow list: if isSuperAdmin();

      allow create: if isAuth() &&
                       (request.resource.data.adminUid == request.auth.uid ||
                        fsId == request.auth.uid);

      // UPDATE: Ein FS-Admin darf seine eigene Fahrschule bearbeiten, ABER
      // 'kalenderAktiv' (bezahltes Extra) darf nur der SuperAdmin setzen.
      allow update: if isSuperAdmin() ||
                       (isFsAdmin() && userFsId() == fsId &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false));

      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERS (Fahrlehrer, Admins, SuperAdmin)
    // ══════════════════════════════════════════════════════
    match /users/{uid} {
      // READ: eigenes Doc, SuperAdmin, oder FsAdmin NUR für Mitglieder der
      // EIGENEN Schule (nicht mehr global – sonst könnte ein FsAdmin fremde
      // Nutzerprofile lesen).
      allow read: if isAuth() && (
                    request.auth.uid == uid ||
                    isSuperAdmin() ||
                    (isFsAdmin() && resource.data.fahrschuleId == userFsId())
                  );

      // CREATE: Beim Anlegen des EIGENEN Kontos dürfen sicherheitsrelevante
      // Felder NICHT frei gewählt werden. rolle muss 'fahrlehrer' oder
      // 'fahrschul-admin' sein (NIE superadmin/fs_admin), kalenderAktiv darf
      // nicht aktiv sein, und fahrschuleId nur die eigene uid oder eine Schule
      // mit gültigem Code. status darf 'aktiv' oder 'ausstehend' sein
      // (Selbstheilung bestehender Konten = 'aktiv'; Neu-Registrierung =
      // 'ausstehend'). Ein selbst angelegtes Konto ist ein isolierter
      // Einzel-Lehrer (eigene Daten) – die Schul-Trennung bleibt geschützt.
      allow create: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        request.auth.uid == uid &&
                        request.resource.data.rolle in ['fahrlehrer', 'fahrschul-admin'] &&
                        request.resource.data.get('status', 'ausstehend') in ['aktiv', 'ausstehend'] &&
                        request.resource.data.get('kalenderAktiv', false) == false &&
                        (
                          request.resource.data.fahrschuleId == request.auth.uid ||
                          fahrschulCodeStimmt()
                        )
                      )
                    );

      // UPDATE: Ein Nutzer darf sein eigenes Doc bearbeiten, aber die
      // sicherheitsrelevanten Felder müssen geschützt sein:
      //  • rolle/kalenderAktiv: NIE durch den Nutzer selbst änderbar
      //  • status: nur FsAdmin/SuperAdmin
      //  • fahrschuleId: nur auf die eigene uid (Schule verlassen) ODER auf
      //    eine Schule, deren Code korrekt mitgesendet wird (Beitritt). Das
      //    verhindert Cross-Tenant-Zugriff durch fahrschuleId-Manipulation.
      // FsAdmin darf nur Mitglieder der eigenen Schule bearbeiten.
      allow update: if isAuth() && (
                      isSuperAdmin() ||
                      (
                        (request.auth.uid == uid ||
                         (isFsAdmin() && resource.data.fahrschuleId == userFsId())) &&
                        request.resource.data.rolle == resource.data.rolle &&
                        request.resource.data.get('kalenderAktiv', false)
                          == resource.data.get('kalenderAktiv', false) &&
                        (
                          isFsAdmin() ||
                          request.resource.data.get('status', '')
                            == resource.data.get('status', '')
                        ) &&
                        (
                          isFsAdmin() ||
                          request.resource.data.fahrschuleId == resource.data.fahrschuleId ||
                          request.resource.data.fahrschuleId == request.auth.uid ||
                          fahrschulCodeStimmt()
                        )
                      )
                    );

      allow delete: if isSuperAdmin() || isFsAdmin();
    }

    // ══════════════════════════════════════════════════════
    // SCHÜLER
    // ══════════════════════════════════════════════════════
    match /students/{studentId} {
      // SuperAdmin darf lesen (nötig zum Auffinden beim Voll-Löschen)
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && (
                       docBelongsToUser(resource.data) ||
                       request.resource.data.uid == request.auth.uid
                     );
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PROTOKOLL
    // ══════════════════════════════════════════════════════
    match /protokoll/{eintragId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM FIELDS
    // ══════════════════════════════════════════════════════
    match /customFields/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM THEMEN
    // ══════════════════════════════════════════════════════
    match /customThemen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // CUSTOM GRUPPEN (eigene Überschriften im Eigene-Tab)
    // ══════════════════════════════════════════════════════
    match /customGruppen/{docId} {
      allow read:   if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
      allow create: if isAuth() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && docBelongsToUser(resource.data);
      allow delete: if isAuth() && (docBelongsToUser(resource.data) || isSuperAdmin());
    }

    // ══════════════════════════════════════════════════════
    // PASSWORT-RESET ANFRAGEN
    // create OHNE Auth (User ist ausgesperrt!) — streng validiert
    // ══════════════════════════════════════════════════════
    match /passwordResets/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['username','kontakt','status','createdAt']) &&
                       request.resource.data.username is string &&
                       request.resource.data.username.size() >= 3 &&
                       request.resource.data.username.size() <= 50 &&
                       request.resource.data.kontakt is string &&
                       request.resource.data.kontakt.size() >= 5 &&
                       request.resource.data.kontakt.size() <= 100 &&
                       request.resource.data.status == 'offen';
      allow read, update, delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // ACCESS CODES (für Schüler-Zugangscodes)
    // ══════════════════════════════════════════════════════
    match /accessCodes/{docId} {
      allow get:  if true;
      allow list: if isAuth() && userDocExists();
      allow create: if isAuth() && userDocExists();
      allow delete: if isAuth() && userDocExists();
      allow update: if (isAuth() && userDocExists()) ||
                       request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['messages', 'plannedLessons', 'lernziele']);
    }

    match /studentSessions/{uid} {
      allow read:   if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid && !userDocExists();
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════
    // CHAT
    // ══════════════════════════════════════════════════════
    match /chat/{msgId} {
      allow read:   if isAuth() &&
                       resource.data.fahrschuleId == userFsId();
      allow create: if isAuth() &&
                       request.resource.data.senderUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuth() &&
                       resource.data.senderUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // PLATFORM (Impressum, Einstellungen)
    // ══════════════════════════════════════════════════════
    match /platform/{docId} {
      // Impressum/Broadcast werden gezielt per get() geladen (das Impressum
      // MUSS öffentlich sein – rechtliche Pflicht). list() ist gesperrt.
      allow get:   if true;
      allow list:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // USERNAMES (Benutzername → E-Mail Zuordnung für Login)
    // Öffentlich lesbar, damit Login per Benutzername funktioniert.
    // Enthält KEINE sensiblen Daten (nur username, email, uid).
    // ══════════════════════════════════════════════════════
    match /usernames/{uname} {
      // get() für den Login-Lookup (Benutzername ist Doc-ID) ist erlaubt.
      // list() ist gesperrt → niemand kann alle Benutzernamen+uids abgreifen
      // (Schutz vor Enumeration / DSGVO).
      allow get:    if true;
      allow list:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // FAHRSCHULKALENDER (separates App, gemeinsames Projekt)
    // Eigene Collections, eigenes Rollensystem (role/approved/schoolId).
    // kalenderUsers ist getrennt von ADKs users, damit keine Kollision.
    // ══════════════════════════════════════════════════════
    function kalAuth() { return request.auth != null; }
    function kalIsSuperAdmin() {
      return kalAuth() && request.auth.token.email == 'chriskoo@mail.de';
    }
    // Existiert mein Kalender-Profil? (Schutz vor get() auf nicht-existentes Doc)
    function kalUserExists() {
      return kalAuth() && exists(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid));
    }
    // Meine eigene Schul-ID (aus meinem kalenderUsers-Profil)
    function kalMySchool() {
      return get(/databases/$(database)/documents/kalenderUsers/$(request.auth.uid)).data.schoolId;
    }
    // Gehört ein Dokument mit dieser schoolId zu MEINER Schule? (oder bin ich SuperAdmin)
    function kalOwnsSchool(sid) {
      return kalIsSuperAdmin() || (kalUserExists() && kalMySchool() == sid);
    }
    // Gehört ein Lehrer (per UID) zu meiner Schule? (für Collections ohne schoolId, z.B. blocked)
    function kalLehrerInMySchool(luid) {
      return kalIsSuperAdmin() ||
             (luid == request.auth.uid) ||
             (kalUserExists() &&
              exists(/databases/$(database)/documents/kalenderUsers/$(luid)) &&
              get(/databases/$(database)/documents/kalenderUsers/$(luid)).data.schoolId == kalMySchool());
    }

    // Die ADK-fahrschuleId des Nutzers (autoritativ, da users.rolle jetzt
    // geschützt ist). Wird genutzt, um die Kalender-schoolId fest an die
    // echte Identität zu binden – so kann niemand eine fremde schoolId wählen.
    function kalAdkFahrschuleId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fahrschuleId
        : null;
    }

    // Kalender-Nutzerprofile: eigenes Doc immer; fremde nur in eigener Schule.
    // WICHTIG: Beim Anlegen/Ändern des eigenen Profils muss die schoolId mit
    // der ADK-fahrschuleId übereinstimmen (oder SuperAdmin) – verhindert, dass
    // sich jemand einer fremden Fahrschule zuordnet (Cross-Tenant-Schutz).
    match /kalenderUsers/{uid} {
      allow read:   if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid) ||
                       (kalUserExists() && resource.data.schoolId == kalMySchool());
      allow create: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid &&
                        request.resource.data.schoolId == kalAdkFahrschuleId());
      allow update: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid &&
                        request.resource.data.schoolId == kalAdkFahrschuleId());
      allow delete: if kalIsSuperAdmin() ||
                       (kalAuth() && request.auth.uid == uid);
    }

    // Fahrschulen im Kalender: nur die eigene
    match /schools/{schoolId} {
      allow read:   if kalIsSuperAdmin() ||
                       (kalUserExists() && kalMySchool() == schoolId);
      allow create: if kalAuth() && request.resource.data.adminUid == request.auth.uid;
      allow update: if kalIsSuperAdmin() ||
                       (kalUserExists() && kalMySchool() == schoolId);
      allow delete: if kalIsSuperAdmin();
    }

    // ── Daten-Collections mit schoolId: streng pro Fahrschule getrennt ──
    // read/update/delete prüfen die schoolId des BESTEHENDEN Dokuments,
    // create prüft die schoolId des NEUEN Dokuments. So kann niemand Daten
    // einer fremden Fahrschule lesen, ändern oder unterschieben.
    match /schueler/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
    }
    match /slots/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
      // Schüler-Selbststorno (OHNE Login): NUR den eigenen gebuchten Termin
      // freigeben (bookedBy -> null). Eng begrenzt:
      //  - nur wenn aktuell gebucht und neuer Wert null
      //  - die angegebene Schüler-ID muss == aktuell Gebuchter sein (Nachweis)
      //  - es dürfen NUR diese Felder geändert werden
      //  - nur, wenn der Termin noch mehr als 48 Std. entfernt ist (serverseitig)
      allow update: if resource.data.bookedBy != null
                    && request.resource.data.bookedBy == null
                    && request.resource.data.storniertVonSchueler == resource.data.bookedBy
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedBy','bookedAt','storniertVonSchueler','storniertAt'])
                    && resource.data.startTime is timestamp
                    && resource.data.startTime > request.time + duration.value(48, 'h');
    }
    match /autos/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /globalBlocked/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId);
      allow create:               if kalOwnsSchool(request.resource.data.schoolId);
    }
    match /urlaub/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
    }
    match /notizen/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
    }
    match /warteliste/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
    }
    match /pruefungen/{docId} {
      allow read, update, delete: if kalOwnsSchool(resource.data.schoolId) || resource.data.lehrerUid == request.auth.uid;
      allow create:               if kalOwnsSchool(request.resource.data.schoolId) || request.resource.data.lehrerUid == request.auth.uid;
    }
    // blocked hat kein schoolId, nur lehrerUid → über den Lehrer absichern
    match /blocked/{docId} {
      allow read, update, delete: if kalLehrerInMySchool(resource.data.lehrerUid);
      allow create:               if kalLehrerInMySchool(request.resource.data.lehrerUid);
    }
    // mailQueue: enthält E-Mail-Inhalte (personenbezogen). Jeder eingeloggte
    // Nutzer darf eine Mail EINREIHEN (create), aber nur SuperAdmin/System
    // darf den Inhalt LESEN. Kein Lesen durch normale Nutzer.
    match /mailQueue/{docId} {
      allow create: if kalAuth();
      allow read:   if kalIsSuperAdmin();
      allow update, delete: if kalIsSuperAdmin();
    }
    // App-Einstellungen: lesen alle Eingeloggten, schreiben nur SuperAdmin
    match /settings/{docId} {
      allow read:  if kalAuth();
      allow write: if kalIsSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    // VARIANTE C – Sichere Schüler-Buchung per Link (OHNE Login)
    // ══════════════════════════════════════════════════════
    // bookingLinks/{lehrerUid}: öffentlicher Schnappschuss der FREIEN Termine
    //   eines Lehrers (lehrerName, schoolName, freieSlots). KEINE Schülerdaten,
    //   KEINE gebuchten Slots. get per ID erlaubt (Link kennt die UID),
    //   list gesperrt (keine Enumeration). Schreiben nur der Lehrer selbst.
    match /bookingLinks/{lehrerUid} {
      allow get:    if true;
      allow list:   if false;
      allow create, update, delete: if isAuth() && request.auth.uid == lehrerUid;
    }
    // bookingStudents/{schuelerId}: nur Vorname + lehrerUid (für die Begrüßung).
    //   get per ID (Link kennt die zufällige Schüler-ID), list gesperrt.
    //   Anlegen durch den eigenen Lehrer; Ändern/Löschen nur durch den Lehrer,
    //   dem das Doc bereits gehört (verhindert Übernahme fremder Links).
    match /bookingWaitlist/{schuelerId} {
      // Schüler liest eigenen Status (per ID); Lehrer listet eigene Einträge.
      allow get:    if true;
      allow list:   if isAuth() && resource.data.lehrerUid == request.auth.uid;
      allow update: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // Austragen: Schüler (kennt eigene schuelerId) oder Lehrer.
      allow delete: if true;
      // Eintragen (ohne Login): nur für aktiven Buchungs-Link, eigene ID, Status 'wartend'.
      allow create: if request.resource.data.status == 'wartend'
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId == schuelerId
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','vorname','status','createdAt'])
                    && exists(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid))
                    && get(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid)).data.aktiv == true;
    }
    match /bookingStudents/{schuelerId} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuth() && request.resource.data.lehrerUid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // Schüler darf (ohne Login) NUR die eigene Terminliste anpassen – z.B.
      // nach einem Selbststorno. lehrerUid/vorname bleiben gesperrt.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meineTermine','updatedAt'])
                    && request.resource.data.lehrerUid == resource.data.lehrerUid;
    }
    // bookingRequests/{id}: Terminanfragen der Schüler.
    //   Schüler DARF anlegen (ohne Login), aber NICHT lesen → kein Abgriff.
    //   create nur mit Pflichtfeldern UND wenn ein realer, AKTIVER Buchungslink
    //   des Lehrers existiert (bindet Anfrage an echte Verknüpfung, bremst Spam).
    //   Lesen/Ändern/Löschen ausschließlich der betroffene Lehrer.
    match /bookingRequests/{reqId} {
      allow read:   if isAuth() && resource.data.lehrerUid == request.auth.uid;
      allow create: if request.resource.data.status == 'angefragt'
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','slotId','start','ende','status'])
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId is string
                    && exists(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid))
                    && get(/databases/$(database)/documents/bookingLinks/$(request.resource.data.lehrerUid)).data.aktiv == true;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════
    // ALLES ANDERE: VERBOTEN
    // ══════════════════════════════════════════════════════
    match /bookingMessages/{msgId} {
      // Lehrer liest/verwaltet eigene Nachrichten; Schüler liest NICHT.
      allow read:           if isAuth() && resource.data.lehrerUid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.lehrerUid == request.auth.uid;
      // Schüler (ohne Login) darf NUR senden – und nur, wenn die schuelerId
      // ein echter, vom Lehrer angelegter Link ist (Anti-Spam) + Längenlimit.
      allow create: if request.resource.data.status == 'neu'
                    && request.resource.data.lehrerUid is string
                    && request.resource.data.schuelerId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.keys().hasAll(['lehrerUid','schuelerId','vorname','text','status','createdAt'])
                    && exists(/databases/$(database)/documents/bookingStudents/$(request.resource.data.schuelerId))
                    && get(/databases/$(database)/documents/bookingStudents/$(request.resource.data.schuelerId)).data.lehrerUid == request.resource.data.lehrerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
